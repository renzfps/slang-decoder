{
  "manifest_version": 3,
  "name": "Slang Decoder",
  "version": "1.0.0",
  "description": "Underlines internet slang and abbreviations like \"lol\" and \"lmfao\" and shows what they mean when you hover.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slang Decoder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dictionary.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
